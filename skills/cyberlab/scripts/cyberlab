#!/usr/bin/env bash
# cyberlab — build and run a minimal, isolated lab that produces the traces of ONE mission
# (one task: one protocol or attack and its consumer). A mission's lab holds as many traces as
# the task needs and is reused for later work on the same task; an unrelated task gets a new lab.
# The host needs only docker (Compose v2). Every check runs in the small tools image
# (tcpdump, tshark, python3); a lab is one victim, one generator and one capture sidecar.
#
# Usage: cyberlab <command> [args]
#   doctor                        check docker, compose and the tools image
#   build                         build the tools image (cyberlab/tools:local)
#   templates                     list the lab templates
#   labs [dir]...                 list mission labs in each dir and its subdirectories: goal, scope
#                                 and traces, to find one to continue (default: the current
#                                 directory, plus $CYBERLAB_HOME or ~/.cache/cyberlab, where
#                                 versions before 1.3.0 put labs)
#   new <dir> --from <template>   copy a template into a lab directory (keeps an existing
#                                 mission.md and expect.json; refuses an existing lab)
#   check <lab>                   isolation policy check of the lab's resolved compose file
#   run <lab> <mode>              policy check, up, runtime isolation check, wait for the
#                                 generator, capture, verified teardown, then verify
#                                 out/<mode>.pcap against expect.json
#   craft <lab> <trace.pcap> -- <craft_pcap.py args>
#   craft <lab> <trace.pcap> --script <file.py> [-- args]
#                                 write a synthetic trace with no network at all, then verify it
#   verify <lab> [trace.pcap]...  check traces in <lab>/out against <lab>/expect.json
#   doc <lab> [trace.pcap]...     (re)write out/<trace>.md: what the trace contains, how it was
#                                 generated and how to reproduce it (run, craft and verify write it too)
#   down <lab> [--images]         tear one lab down; --images also removes the images compose
#                                 built for it (pulled images and the tools image are kept)
#   status [lab]                  containers, networks, volumes and built images of every cyberlab
#                                 lab (or one); the dry-run of down --images and nuke
#   nuke [--images]               remove every cyberlab-* container, network and volume
#                                 (--images: and every image built for a cyberlab-* lab)
#
# Env: CYBERLAB_TOOLS (default cyberlab/tools:local), CYBERLAB_TIMEOUT (generator wait, default
#      300 s). Exit: 0 ok, 1 usage/environment error, 2 a policy, lab or expectation check failed.
set -u
die() { echo "Error: $1" >&2; exit "${2:-1}"; }
SKILL_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
TOOLS="${CYBERLAB_TOOLS:-cyberlab/tools:local}"
TIMEOUT="${CYBERLAB_TIMEOUT:-300}"
export CYBERLAB_TOOLS="$TOOLS"
usage() { awk 'NR>1 && /^#/{sub(/^# ?/,"");print;next} NR>1{exit}' "$0"; }

need_docker() {
  command -v docker >/dev/null || die "docker not found. Install Docker Desktop (macOS/Windows) or Docker Engine with the Compose v2 plugin."
  docker info >/dev/null 2>&1 || die "the Docker daemon is not reachable. Start Docker Desktop or the docker service, then retry."
  docker compose version >/dev/null 2>&1 || die "'docker compose' (v2) not found. Install the Compose plugin; docker-compose v1 is not supported."
}
need_tools() { docker image inspect "$TOOLS" >/dev/null 2>&1 || die "tools image $TOOLS not found. Run: cyberlab build"; }
abspath() { if [ -d "$1" ]; then (cd "$1" && pwd -P); else echo "$(cd "$(dirname "$1")" && pwd -P)/$(basename "$1")"; fi; }
need_lab() { [ -f "$1/docker-compose.yml" ] || die "no docker-compose.yml in $1. Create one with: cyberlab new <dir> --from <template>"; }

# tools <docker args...> -- <cmd...>: run in the tools image, no network, no capabilities
tools() {
  local args=()
  while [ $# -gt 0 ] && [ "$1" != "--" ]; do args+=("$1"); shift; done
  [ "${1:-}" = "--" ] && shift
  docker run --rm -i --network none --cap-drop ALL --security-opt no-new-privileges \
    --user "$(id -u):$(id -g)" --label org.cyberlab.role=tools-run -v "$SKILL_DIR/scripts:/cyberlab:ro" ${args[@]+"${args[@]}"} "$TOOLS" "$@"
}

compose_json() { # <lab>: resolved compose JSON on stdout; on failure the compose error, exit 1
  local err; err="$(mktemp)"; local out
  out="$(cd "$1" && docker compose config --format json 2>"$err")" || { cat "$err"; rm -f "$err"; return 1; }
  rm -f "$err"; printf '%s' "$out"
}
modes_of() { # <lab>: the modes named by expect.json traces (<mode>.pcap)
  tools -v "$1:/lab:ro" -- python3 -c 'import json; [print(t[:-5]) for t in json.load(open("/lab/expect.json")).get("traces", {}) if t.endswith(".pcap")]' 2>/dev/null
}
project_of() { compose_json "$1" | tools -- python3 -c 'import json,sys; print(json.load(sys.stdin).get("name",""))' 2>/dev/null; }

require_expectation() { # <lab> <trace>: expect.json is valid and lists the trace
  [ -f "$1/expect.json" ] || die "no $1/expect.json. Write what the trace must show before generating it (references/mission.md)."
  local rc=0
  tools -v "$1:/lab:ro" -- python3 -c 'import json,sys
try: d = json.load(open("/lab/expect.json"))
except Exception: sys.exit(3)
sys.exit(0 if sys.argv[1] in d.get("traces", {}) else 2)' "$2" 2>/dev/null || rc=$?
  [ "$rc" = 3 ] && die "$1/expect.json is not valid JSON. Fix it (references/mission.md shows the format)."
  [ "$rc" = 0 ] || die "no expectation for $2 in $1/expect.json. Write what the trace must show before generating it (references/mission.md)."
}
no_symlinks() { # <lab>: a symlink could point a bind mount at any host path
  local l; l="$(find "$1" -type l 2>/dev/null | head -3)"
  [ -z "$l" ] || die "the lab contains symlinks ($(echo "$l" | tr '\n' ' ')). Replace them with real files: bind mounts must stay inside the lab." 2
}

policy() { # <lab> [--runner]   (checks the model as `up` will see it: MODE/PCAP must be exported)
  local lab="$1"; shift
  no_symlinks "$lab"
  local json; json="$(compose_json "$lab")" || die "docker compose config failed in $lab: $json" 2
  printf '%s' "$json" | tools -- python3 /cyberlab/lab_policy.py --lab-dir "$(cd "$lab" && pwd)" \
    --lab-dir "$(cd "$lab" && pwd -P)" --tools-image "$TOOLS" "$@"
}

cmd_doctor() {
  need_docker
  echo "PASS docker   $(docker version -f '{{.Server.Version}}' 2>/dev/null) ($(docker info -f '{{.OSType}}/{{.Architecture}}' 2>/dev/null))"
  echo "PASS compose  $(docker compose version --short 2>/dev/null)"
  if docker image inspect "$TOOLS" >/dev/null 2>&1; then
    echo "PASS tools    $TOOLS: $(tools -- sh -c 'tshark --version | head -1; tcpdump --version 2>&1 | head -1; python3 --version' | tr '\n' ';')"
  else
    echo "FAIL tools    $TOOLS missing. Run: cyberlab build"; exit 2
  fi
  local rt; rt="$(docker info -f '{{range $k, $v := .Runtimes}}{{$k}} {{end}}' 2>/dev/null)"
  case "$rt" in *runsc*|*kata*) echo "NOTE runtime  hardened runtime available ($rt)";; *) echo "NOTE runtime  default runc only: isolation is Docker-level (references/safety.md)";; esac
}

cmd_build() {
  need_docker
  docker build -q -t "$TOOLS" "$SKILL_DIR/assets/tools" >/dev/null || die "tools image build failed. Re-run 'docker build $SKILL_DIR/assets/tools' to see the error." 2
  echo "PASS build $TOOLS"
}

cmd_templates() {
  local d
  for d in "$SKILL_DIR"/assets/labs/*/; do
    printf '%-18s %s\n' "$(basename "$d")" "$(sed -n 's/^# *summary: *//p' "$d/docker-compose.yml" | head -1)"
  done
}

cmd_labs() { # [dir]...: mission labs (dirs holding mission.md) with goal, scope and traces
  local dirs=("$@") d l nl=$'\n' seen=$'\n' found=0
  if [ $# -eq 0 ]; then
    dirs=("$PWD"); l="${CYBERLAB_HOME:-$HOME/.cache/cyberlab}"; [ -d "$l" ] && dirs+=("$l")
  fi
  for d in "${dirs[@]}"; do
    [ -d "$d" ] || { echo "no labs: $d does not exist"; continue; }
    for l in "$d" "$d"/*/; do
      [ -f "$l/mission.md" ] || continue
      l="$(cd "$l" && pwd -P)"
      case "$seen" in *"$nl$l$nl"*) continue;; esac
      seen="$seen$l$nl"; found=1
      echo "$l"
      echo "  goal:   $(sed -n 's/^# *Mission: *//p' "$l/mission.md" | head -1)"
      echo "  scope:  $(sed -n 's/^- *Scope: *//p' "$l/mission.md" | head -1)"
      echo "  traces: $(cd "$l" && ls out/*.pcap 2>/dev/null | sed 's|^out/||' | tr '\n' ' ')"
    done
  done
  [ "$found" = 1 ] || echo "no labs with a mission.md in ${dirs[*]} or their subdirectories"
}

cmd_new() {
  local dir="${1:-}" from=""; [ $# -gt 0 ] && shift
  [ -n "$dir" ] || die "usage: cyberlab new <dir> --from <template>"
  while [ $# -gt 0 ]; do case "$1" in --from) from="${2:-}"; shift 2;; *) die "new: unknown option '$1'.";; esac; done
  local list; list="$(ls "$SKILL_DIR/assets/labs" | tr '\n' ' ')"
  [ -n "$from" ] || die "new: missing --from <template>. Templates: $list"
  [ -d "$SKILL_DIR/assets/labs/$from" ] || die "new: no template '$from'. Templates: $list"
  [ -e "$dir/docker-compose.yml" ] && die "new: $dir already holds a lab (docker-compose.yml); nothing was overwritten. To add traces to this mission, keep this lab and skip new; for an unrelated task pick a new directory."
  mkdir -p "$dir" || die "new: cannot create $dir."
  cp -Rn "$SKILL_DIR/assets/labs/$from/." "$dir/" 2>/dev/null   # -n keeps mission.md/expect.json; BSD cp exits 1 when it skips
  [ -f "$dir/docker-compose.yml" ] || die "new: cannot copy the template into $dir."
  local short; short="$(basename "$dir" | tr '[:upper:]_. ' '[:lower:]---' | tr -cd 'a-z0-9-')"
  sed -i.bak "s/^name: cyberlab-.*/name: cyberlab-$short/" "$dir/docker-compose.yml" && rm -f "$dir/docker-compose.yml.bak"
  echo "PASS new $dir (template $from, project cyberlab-$short). Next: edit it and expect.json, then: cyberlab check $dir"
}

cmd_check() { # checks the lab once per mode named in expect.json (variables can differ per mode)
  [ $# -eq 1 ] || die "usage: cyberlab check <lab>"
  need_lab "$1"; need_docker; need_tools
  local lab; lab="$(abspath "$1")"
  local modes m rc=0; modes="$( [ -f "$lab/expect.json" ] && modes_of "$lab")"
  [ -n "$modes" ] || { echo "NOTE check: no expect.json traces yet; checking with MODE unset"; modes="-"; }
  for m in $modes; do
    if [ "$m" = "-" ]; then unset MODE PCAP; else export MODE="$m" PCAP="$m"; echo "--- mode $m"; fi
    policy "$lab" --runner || rc=2
  done
  return "$rc"
}

runtime_isolation() { # <project>: verify the RUNNING lab; fails when nothing is found
  local proj="$1" bad=0 nets cons n c
  nets="$(docker network ls -q --filter "label=com.docker.compose.project=$proj")"
  cons="$(docker ps -aq --filter "label=com.docker.compose.project=$proj")"
  [ -n "$nets" ] || { echo "FAIL runtime no network found for project $proj"; return 1; }
  [ -n "$cons" ] || { echo "FAIL runtime no container found for project $proj"; return 1; }
  for n in $nets; do
    [ "$(docker network inspect -f '{{.Internal}}' "$n")" = true ] || { echo "FAIL runtime network $(docker network inspect -f '{{.Name}}' "$n") is not internal"; bad=1; }
    [ "$(docker network inspect -f '{{index .Options "com.docker.network.bridge.inhibit_ipv4"}}' "$n")" = true ] || { echo "FAIL runtime network $(docker network inspect -f '{{.Name}}' "$n") gives the host an address (inhibit_ipv4 not set)"; bad=1; }
  done
  for c in $cons; do
    for n in $(docker inspect -f '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}' "$c"); do
      [ "$(docker network inspect -f '{{.Internal}}' "$n" 2>/dev/null)" = true ] || { echo "FAIL runtime $c is attached to non-internal network $n"; bad=1; }
    done
    case "$(docker inspect -f '{{json .HostConfig.PortBindings}}' "$c")" in "{}"|"null"|"") ;; *) echo "FAIL runtime $c publishes ports"; bad=1;; esac
    [ "$(docker inspect -f '{{.HostConfig.Privileged}}' "$c")" = false ] || { echo "FAIL runtime $c is privileged"; bad=1; }
    [ "$(docker inspect -f '{{.HostConfig.NetworkMode}}' "$c")" = host ] && { echo "FAIL runtime $c uses the host network"; bad=1; }
  done
  [ "$bad" = 0 ] && echo "PASS runtime isolation verified on $(echo "$cons" | wc -w | tr -d ' ') running container(s), $(echo "$nets" | wc -w | tr -d ' ') network(s)"
  return "$bad"
}

lab_addresses() { # <project>: {"<service>": {"ipv4", "ipv6", "mac"}} of its containers, read while they run
  # (an exited container has no address any more; capture shares the victim's and has none of its own)
  local c svc ip4 ip6 mac out=""
  for c in $(docker ps -aq --filter "label=com.docker.compose.project=$1"); do
    svc="$(docker inspect -f '{{index .Config.Labels "com.docker.compose.service"}}' "$c" 2>/dev/null)"
    IFS=, read -r ip4 ip6 mac <<EOF
$(docker inspect -f '{{range .NetworkSettings.Networks}}{{.IPAddress}},{{.GlobalIPv6Address}},{{.MacAddress}}{{"\n"}}{{end}}' "$c" 2>/dev/null | head -1)
EOF
    case "$ip4" in *[!0-9.]*) ip4="";; esac   # Docker prints "invalid IP" for an address it does not have
    case "$ip6" in *[!0-9a-fA-F:]*) ip6="";; esac
    case "$mac" in *[!0-9a-fA-F:]*) mac="";; esac
    [ -n "$svc" ] && [ -n "$ip4$ip6$mac" ] || continue
    out="$out${out:+, }$(jstr "$svc"): {\"ipv4\": $(jstr "$ip4"), \"ipv6\": $(jstr "$ip6"), \"mac\": $(jstr "$mac")}"
  done
  printf '{%s}' "$out"
}

skill_version() { sed -n 's/^ *version: *//p' "$SKILL_DIR/SKILL.md" | head -1; }
shq() { # quote arguments for a command line a person can paste
  local out="" a q="'"
  for a in "$@"; do case "$a" in ""|*[!A-Za-z0-9_./:=@%+,-]*) a="$q${a//$q/$q\\$q$q}$q";; esac; out="$out${out:+ }$a"; done
  printf '%s' "$out"
}
jstr() { printf '"%s"' "$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g')"; }

write_provenance() { # <lab> <trace> <origin> <generator> <command> <compose json|null> <env json> <extra fields ", k: v"> [image id]...
  local lab="$1" trace="$2" origin="$3" gen="$4" command="$5" compose="$6" env="$7" extra="$8"; shift 8
  local froms ref o inspect="" ids=""
  froms="$(tools -v "$lab:/lab:ro" -- python3 /cyberlab/trace_doc.py lab-files --lab /lab 2>/dev/null |
           tools -- python3 -c 'import json,sys; print("\n".join(json.load(sys.stdin)["froms"]))' 2>/dev/null)"
  for ref in "$@"; do ids="$ids${ids:+,}$(jstr "$ref")"; done
  for ref in "$@" $froms "$TOOLS"; do   # one by one: an image that is not present must not hide the others
    o="$(docker image inspect "$ref" 2>/dev/null)" || continue
    o="${o#\[}"; o="${o%\]}"; inspect="$inspect${inspect:+,}$o"
  done
  local ctx; ctx="{\"lab_name\": $(jstr "$(basename "$lab")"), \"lab_host_dir\": $(jstr "$lab"),
    \"host\": {\"docker\": $(jstr "$(docker version -f '{{.Server.Version}}' 2>/dev/null)"), \"platform\": $(jstr "$(docker info -f '{{.OSType}}/{{.Architecture}}' 2>/dev/null)")},
    \"tools_id\": $(jstr "$(docker image inspect -f '{{.Id}}' "$TOOLS" 2>/dev/null)"),
    \"image_ids\": [$ids], \"inspect\": [$inspect], \"compose\": ${compose:-null}, \"env\": ${env:-null}$extra}"
  printf '%s' "$ctx" | tools -v "$lab:/lab" -- python3 /cyberlab/trace_doc.py provenance --lab /lab --trace "$trace" \
    --origin "$origin" --generator "$gen" --command "$command" --version "$(skill_version)" --tools-image "$TOOLS"
}

no_provenance() { # <lab> <trace>: write_provenance failed. An earlier run's provenance and document
  # describe another file, so remove them rather than leave them next to the new trace.
  rm -f "$1/out/${2%.pcap}.provenance.json" "$1/out/${2%.pcap}.md"
  die "could not write out/${2%.pcap}.provenance.json (above): the trace has no provenance." 2
}
write_docs() { # <lab> [trace]...: out/<trace>.md, the trace's reproduction document (never fails the command)
  local lab="$1"; shift
  local a=(); for t in "$@"; do a+=(--trace "$t"); done
  tools -v "$lab:/lab" -- python3 /cyberlab/trace_doc.py doc --lab /lab --lab-name "$(basename "$lab")" --version "$(skill_version)" ${a[@]+"${a[@]}"} ||
    echo "NOTE doc    could not write every trace document (above); rerun: cyberlab doc $lab"
}

verify_traces() { # <lab> <trace>...
  local lab="$1"; shift
  local a=(); for t in "$@"; do a+=(--trace "$t"); done
  tools -v "$lab:/lab" -- python3 /cyberlab/verify.py --lab /lab ${a[@]+"${a[@]}"}
}

cmd_run() {
  [ $# -eq 2 ] || die "usage: cyberlab run <lab> <mode>   (example: cyberlab run labs/ftp attack -> out/attack.pcap)"
  local lab="$1" mode="$2"
  case "$mode" in *[!a-z0-9_-]*|"") die "mode '$mode' must use lowercase letters, digits, - or _ (it names out/<mode>.pcap).";; esac
  need_lab "$lab"; need_docker; need_tools
  lab="$(abspath "$lab")"
  require_expectation "$lab" "$mode.pcap"
  export MODE="$mode" PCAP="$mode"
  policy "$lab" --runner || die "the lab breaks the isolation policy (FAIL lines above); it was not started." 2
  local proj; proj="$(project_of "$lab")"
  case "$proj" in cyberlab-*) ;; *) die "cannot read the lab's project name (got '$proj')." 2;; esac
  mkdir -p "$lab/out" && rm -f "$lab/out/$mode.pcap" "$lab/out/$mode.pcap.rejected" "$lab/out/$mode.provenance.json" "$lab/out/$mode.md"
  cd "$lab" || die "cannot cd to $lab"
  cleanup() { docker compose down -v --remove-orphans >/dev/null 2>&1; }
  reject() { [ -f "out/$mode.pcap" ] && mv "out/$mode.pcap" "out/$mode.pcap.rejected"; die "$1" 2; }
  trap cleanup EXIT
  trap 'cleanup; echo "Error: interrupted; the lab was torn down." >&2; exit 130' INT TERM
  if grep -qE '^\s*build:' docker-compose.yml; then
    docker compose build -q || die "docker compose build failed (see above). Builds may download; the running lab stays offline." 2
  fi
  docker compose up -d >"out/.$mode.up.log" 2>&1 || { cat "out/.$mode.up.log" >&2; die "docker compose up failed (log: $lab/out/.$mode.up.log)." 2; }
  local addrs; addrs="$(lab_addresses "$proj")"   # at once: the generator may finish within seconds
  runtime_isolation "$proj" || die "the running lab is not isolated; it was torn down." 2
  echo "NOTE address $(printf '%s' "$addrs" | tr -d '{}"' | sed 's/: ipv4: /=/g; s/, ipv6: [^,]*, mac: [^,]*//g')"
  local cid; cid="$(docker compose ps -aq generator)"
  [ -n "$cid" ] || die "generator container not found after up." 2
  local waited=0 st
  while :; do
    st="$(docker inspect -f '{{.State.Status}}' "$cid" 2>/dev/null)"
    { [ "$st" = exited ] || [ "$st" = dead ]; } && break
    [ "$waited" -ge "$TIMEOUT" ] && { docker compose logs --no-log-prefix generator 2>&1 | tail -10; die "generator still running after ${TIMEOUT}s (CYBERLAB_TIMEOUT); the lab was torn down." 2; }
    sleep 1; waited=$((waited + 1))
  done
  local rc; rc="$(docker inspect -f '{{.State.ExitCode}}' "$cid")"
  docker compose logs --no-log-prefix generator >"out/$mode.generator.log" 2>&1
  echo "--- generator log (last 5 lines of out/$mode.generator.log)"; tail -5 "out/$mode.generator.log"
  sleep 2   # libpcap hands packets over in batches: stopping at once loses the tail
  docker compose stop -t 5 capture >/dev/null 2>&1
  docker compose logs --no-log-prefix capture >"out/$mode.capture.log" 2>&1
  rm -f "out/$mode.pcap"   # only tcpdump's file, copied from the capture container, may become the trace
  local copied=1; docker compose cp "capture:/cap/$mode.pcap" "out/$mode.pcap" >/dev/null 2>&1 || copied=0
  local dropped; dropped="$(sed -n 's/^\([0-9][0-9]*\) packets\{0,1\} dropped by kernel.*/\1/p' "out/$mode.capture.log" | tail -1)"
  local imgjson images image_ids compose_resolved
  imgjson="$(docker compose images --format json 2>/dev/null)"
  images="$(printf '%s' "$imgjson" | tools -- python3 -c 'import json,sys; print(json.dumps(sorted({i["Repository"]+":"+i["Tag"]+"@"+i["ID"][:19] for i in json.load(sys.stdin)})))' 2>/dev/null || echo '[]')"
  image_ids="$(printf '%s' "$imgjson" | tools -- python3 -c 'import json,sys; print(" ".join(sorted({i["ID"] for i in json.load(sys.stdin)})))' 2>/dev/null)"
  compose_resolved="$(compose_json "$lab" 2>/dev/null)" || compose_resolved=null
  cleanup; trap - EXIT INT TERM
  local left; left="$(docker ps -aq --filter "label=com.docker.compose.project=$proj")$(docker network ls -q --filter "label=com.docker.compose.project=$proj")"
  [ -z "$left" ] || die "lab resources still present after teardown. Run: cyberlab down $lab" 2
  echo "PASS teardown nothing left for $proj"
  [ "$rc" = 0 ] || reject "generator exited with code $rc (out/$mode.generator.log). Fix the lab; never swap in a crafted trace silently."
  [ "$copied" = 1 ] || die "no /cap/$mode.pcap in the capture container: its tcpdump must write -w /cap/\${PCAP}.pcap." 2
  [ -s "out/$mode.pcap" ] || die "out/$mode.pcap is missing or empty: the capture saw nothing. Check the capture's interface and BPF filter." 2
  [ -n "$dropped" ] || reject "no tcpdump summary in out/$mode.capture.log: cannot tell whether packets were lost."
  [ "$dropped" = 0 ] || reject "the capture dropped $dropped packet(s) (out/$mode.capture.log): the trace is incomplete. Raise tcpdump's buffer (-B 65536) or slow the generator, then run again."
  echo "PASS capture 0 packets dropped by kernel"
  local pk_sha; pk_sha="$(write_provenance "$lab" "$mode.pcap" "lab capture" "$(basename "$lab") mode $mode" "cyberlab run <lab> $mode" \
    "$compose_resolved" "{\"MODE\": $(jstr "$mode"), \"PCAP\": $(jstr "$mode"), \"CYBERLAB_TIMEOUT\": $(jstr "$TIMEOUT")}" \
    ", \"project\": \"$proj\", \"generator_exit\": $rc, \"dropped\": 0, \"images\": $images, \"addresses\": ${addrs:-null}" $image_ids)" && [ -n "$pk_sha" ] ||
    no_provenance "$lab" "$mode.pcap"
  echo "NOTE trace   out/$mode.pcap: ${pk_sha%% *} frames, provenance out/$mode.provenance.json"
  local vrc=0; verify_traces "$lab" "$mode.pcap" || vrc=$?
  write_docs "$lab" "$mode.pcap"
  return "$vrc"
}

cmd_craft() {
  [ $# -ge 2 ] || die "usage: cyberlab craft <lab> <trace.pcap> -- <craft_pcap.py args>  |  --script <file.py> [-- args]"
  local lab="$1" trace="$2"; shift 2
  case "$trace" in *[!A-Za-z0-9._-]*|.*) die "craft: trace name '$trace' may use only letters, digits, '.', '_' and '-'.";; *.pcap) ;; *) die "craft: the trace name must end in .pcap (got '$trace').";; esac
  [ -d "$lab" ] || die "craft: lab directory $lab does not exist (mkdir it, and write expect.json first)."
  need_docker; need_tools
  lab="$(abspath "$lab")"
  require_expectation "$lab" "$trace"
  local script=""
  if [ "${1:-}" = "--script" ]; then
    script="${2:-}"; shift 2
    [ -f "$lab/$script" ] || die "craft: script $lab/$script not found (it must sit inside the lab directory)."
  fi
  [ "${1:-}" = "--" ] && shift
  mkdir -p "$lab/out" && rm -f "$lab/out/$trace"   # provenance and document are rewritten in place (atomically)
  local gen cmdline
  if [ -n "$script" ]; then
    gen="python3 $script $*"
    cmdline="cyberlab craft <lab> $trace --script $(shq "$script")${1+ -- $(shq "$@")}"
    tools -v "$lab:/lab" -w /lab -e "OUT=/lab/out/$trace" -- python3 "/lab/$script" "$@" || die "craft script failed (above)." 2
  else
    gen="craft_pcap.py $*"
    cmdline="cyberlab craft <lab> $trace -- $(shq "$@")"
    tools -v "$lab:/lab" -w /lab -- python3 /cyberlab/craft_pcap.py --out "/lab/out/$trace" "$@" || die "craft_pcap.py failed (above). Run 'python3 $SKILL_DIR/scripts/craft_pcap.py --help' for its arguments." 2
  fi
  [ -s "$lab/out/$trace" ] || die "craft: $lab/out/$trace was not written. A --script must write to \$OUT." 2
  local pk_sha; pk_sha="$(write_provenance "$lab" "$trace" "crafted (synthetic)" "$gen" "$cmdline" null null "")" && [ -n "$pk_sha" ] ||
    no_provenance "$lab" "$trace"
  echo "NOTE trace   out/$trace: ${pk_sha%% *} frames, SYNTHETIC, provenance out/${trace%.pcap}.provenance.json"
  local vrc=0; verify_traces "$lab" "$trace" || vrc=$?
  write_docs "$lab" "$trace"
  return "$vrc"
}

cmd_verify() {
  [ $# -ge 1 ] || die "usage: cyberlab verify <lab> [trace.pcap]..."
  local lab="$1"; shift
  [ -f "$lab/expect.json" ] || die "no $lab/expect.json (references/mission.md says how to write it)."
  local t ts=(); for t in "$@"; do [ "$t" = "--trace" ] || ts+=("$t"); done   # accept "--trace X" too
  set -- ${ts[@]+"${ts[@]}"}
  need_docker; need_tools
  lab="$(abspath "$lab")"
  local vrc=0; verify_traces "$lab" "$@" || vrc=$?
  [ -d "$lab/out" ] && write_docs "$lab" "$@"
  return "$vrc"
}

cmd_doc() { # <lab> [trace.pcap]...: (re)write out/<trace>.md from mission.md, expect.json, verify.json and provenance
  [ $# -ge 1 ] || die "usage: cyberlab doc <lab> [trace.pcap]..."
  local lab="$1"; shift
  [ -d "$lab/out" ] || die "no $lab/out: generate a trace first (cyberlab run or craft)."
  need_docker; need_tools
  lab="$(abspath "$lab")"
  local a=(); for t in "$@"; do a+=(--trace "$t"); done
  tools -v "$lab:/lab" -- python3 /cyberlab/trace_doc.py doc --lab /lab --lab-name "$(basename "$lab")" --version "$(skill_version)" ${a[@]+"${a[@]}"} || die "trace_doc.py failed (above)." 2
}

cmd_down() {
  local lab="" rmi=()
  while [ $# -gt 0 ]; do case "$1" in --images) rmi=(--rmi local); shift;; -*) die "down: unknown option '$1'.";; *) [ -z "$lab" ] || die "usage: cyberlab down <lab> [--images]"; lab="$1"; shift;; esac; done
  [ -n "$lab" ] || die "usage: cyberlab down <lab> [--images]"
  need_lab "$lab"; need_docker
  # --rmi local removes only the images compose built for this lab, never pulled ones
  (cd "$lab" && docker compose down -v --remove-orphans ${rmi[@]+"${rmi[@]}"}) || die "docker compose down failed in $lab." 2
  echo "PASS down $lab${rmi[*]:+ (built images removed)}"
}

built_images() { # 'image <name> <project>' for every image compose built (it labels them with the project)
  local ids; ids="$(docker image ls -q --filter label=com.docker.compose.project | sort -u)"
  [ -n "$ids" ] || return 0
  # shellcheck disable=SC2086
  docker image inspect -f 'image {{if .RepoTags}}{{index .RepoTags 0}}{{else}}{{.Id}}{{end}} {{index .Config.Labels "com.docker.compose.project"}}' $ids 2>/dev/null
}
cmd_status() { # [lab]: containers, networks, volumes and built images of cyberlab labs (or of one lab)
  need_docker
  local want='^cyberlab-'
  if [ $# -ge 1 ]; then need_lab "$1"; need_tools; want="^$(project_of "$(abspath "$1")")\$"; fi
  local rows imgs
  rows="$( { docker ps -a --format 'container {{.Names}} {{.Label "com.docker.compose.project"}}';
             docker network ls --format 'network {{.Name}} {{.Label "com.docker.compose.project"}}';
             docker volume ls --format 'volume {{.Name}} {{.Label "com.docker.compose.project"}}'; } |
           awk -v w="$want" 'NF>=3 && $NF ~ w')"
  imgs="$(built_images | awk -v w="$want" 'NF>=3 && $NF ~ w')"
  [ -n "$rows" ] && echo "$rows"
  [ -n "$imgs" ] && echo "$imgs"
  if [ -z "$rows$imgs" ]; then echo "no cyberlab lab resources"
  elif [ -z "$rows" ]; then
    echo "NOTE no container, network or volume left; $(echo "$imgs" | wc -l | tr -d ' ') built image(s) kept for reruns (down <lab> --images or nuke --images removes them)"
  fi
}

cmd_nuke() {
  local images=0
  while [ $# -gt 0 ]; do case "$1" in --images) images=1; shift;; *) die "nuke: unknown option '$1'. Usage: cyberlab nuke [--images]";; esac; done
  need_docker
  local projs p ids
  projs="$( { docker ps -a --format '{{.Label "com.docker.compose.project"}}'; docker network ls --format '{{.Label "com.docker.compose.project"}}'; docker volume ls --format '{{.Label "com.docker.compose.project"}}';
              [ "$images" = 1 ] && built_images | awk '{print $NF}'; } | grep '^cyberlab-' | sort -u)"
  [ -n "$projs" ] || { echo "PASS nuke: nothing to remove"; return 0; }
  for p in $projs; do
    docker ps -aq --filter "label=com.docker.compose.project=$p" | xargs docker rm -f >/dev/null 2>&1
    docker network ls -q --filter "label=com.docker.compose.project=$p" | xargs docker network rm >/dev/null 2>&1
    docker volume ls -q --filter "label=com.docker.compose.project=$p" | xargs docker volume rm >/dev/null 2>&1
    if [ "$images" = 1 ]; then
      ids="$(docker image ls -q --filter "label=com.docker.compose.project=$p" | sort -u)"
      # shellcheck disable=SC2086
      [ -z "$ids" ] || docker image rm -f $ids >/dev/null 2>&1
    fi
    echo "removed $p"
  done
  echo "PASS nuke"
}

c="${1:-}"; [ $# -gt 0 ] && shift
case "$c" in
  doctor) cmd_doctor "$@";; build) cmd_build "$@";; templates) cmd_templates;; labs) cmd_labs "$@";; new) cmd_new "$@";;
  check) cmd_check "$@";; run) cmd_run "$@";; craft) cmd_craft "$@";; verify) cmd_verify "$@";; doc) cmd_doc "$@";;
  down) cmd_down "$@";; status) cmd_status "$@";; nuke) cmd_nuke "$@";;
  -h|--help|help) usage;;
  "") usage; exit 1;;
  *) die "unknown command '$c'. Run 'cyberlab --help'.";;
esac
